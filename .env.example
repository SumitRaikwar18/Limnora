NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Optional: an existing original observation with explicit showcase permission.
NEXT_PUBLIC_SHOWCASE_OBSERVATION_ID=
# Verified public HTTPS origin, e.g. your owned deployment domain (no path).
# Set before production build; blank keeps the site noindex.
NEXT_PUBLIC_SITE_URL=
